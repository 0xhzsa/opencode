{
  "name": "code-coach",
  "displayName": "Code Coach",
  "description": "An AI coach that watches your prompts and diffs, teaches first principles, and learns from you.",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Linters", "Education"],
  "activationEvents": [
    "onView:code-coach.welcome",
    "onCommand:code-coach.coachPrompt",
    "onCommand:code-coach.coachClipboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "viewpoint": "code-coach.welcome",
        "activationEvents": "onView:code-coach.welcome",
        "group": "1_high",
        "contents": "Code Coach is watching your edits. Save a file to start."
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "code-coach.welcome",
          "name": "Code Coach"
        }
      ]
    },
    "commands": [
      {
        "command": "code-coach.coachPrompt",
        "title": "Code Coach: Coach this prompt"
      },
      {
        "command": "code-coach.coachClipboard",
        "title": "Code Coach: Coach the clipboard prompt"
      },
      {
        "command": "code-coach.snooze",
        "title": "Code Coach: Snooze for 5 minutes"
      },
      {
        "command": "code-coach.showProfile",
        "title": "Code Coach: Show learner profile"
      },
      {
        "command": "code-coach.clearProfile",
        "title": "Code Coach: Reset learner profile"
      }
    ],
    "configuration": {
      "title": "Code Coach",
      "properties": {
        "codeCoach.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the code-coach-mcp dist/index.js. Leave empty to use the sibling package."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "oxlint src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/bun": "^1.2.0"
  }
}
